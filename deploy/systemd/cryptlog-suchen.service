[Unit]
Description=CryptLog Suchprozess
After=network-online.target
Wants=network-online.target

[Service]
# Ein Prozess unter diesem Konto, einem anderen als cryptlog-schreiben.
# Ein zweiter Start unterbleibt, solange er läuft. Das Protokoll der Zone bleibt liegen.
# Geheimnisse nennt die Konfiguration. Sie liegen auf dem tmpfs unter /run, nicht in dieser Unit.
# TimeoutStopSec ist mindestens die Segment-Wartezeit plus 30 Sekunden. frist lehnt Kürzeres ab.
Type=simple
User=cryptlog-suchen
Group=cryptlog-suchen
UMask=0077
WorkingDirectory=/var/lib/cryptlog/suchen
StateDirectory=cryptlog/suchen
StateDirectoryMode=0700
ConfigurationDirectory=cryptlog
ConfigurationDirectoryMode=0755
ExecStart=/usr/bin/cryptlog suchen /etc/cryptlog/suchen.conf
ExecStartPre=+/bin/sh /usr/lib/cryptlog/frist /etc/cryptlog/suchen.conf cryptlog-suchen.service
Restart=always
RestartSec=5s
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=390
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cryptlog-suchen
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
